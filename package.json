{
  "name": "instapaper-mcp-server",
  "version": "2.0.0",
  "description": "Instapaper MCP server for Cloudflare Workers and stdio clients",
  "type": "module",
  "main": "build/stdio.js",
  "bin": {
    "instapaper-mcp": "./build/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "stdio": "tsx src/stdio.ts",
    "inspector": "npx @modelcontextprotocol/inspector npx tsx src/stdio.ts",
    "setup:instapaper": "tsx scripts/setup-instapaper.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.0",
    "oauth-1.0a": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260901.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.35.0"
  },
  "keywords": [
    "mcp",
    "instapaper",
    "model-context-protocol",
    "cloudflare-workers"
  ],
  "license": "MIT"
}
